# Copy to .env and adjust. Environment variables override this file.

# SQLite database file (relative paths resolve against the repo root)
DATABASE_PATH=data/boekhouden.db

# Content-addressed document storage (never delete files here)
DOCUMENTS_DIR=data/documents

# Web server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# Claude API key for invoice extraction (optional, not used yet)
# ANTHROPIC_API_KEY=
