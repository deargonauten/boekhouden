# Copy to .env and adjust. Environment variables override this file.

# SQLite database file (relative paths resolve against the repo root)
DATABASE_PATH=data/boekhouden.db

# Content-addressed document storage (never delete files here)
DOCUMENTS_DIR=data/documents

# Web server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# Invoice extraction (reading PDFs/photos with Claude).
# auto: use the `claude` CLI when you are logged in (counts against your plan;
# run `claude auth login` once), otherwise the API key below.
# Or force one: claude_cli | anthropic_api
EXTRACTION_BACKEND=auto
# Model alias for the CLI backend
EXTRACTION_MODEL=sonnet
# Model id for the API backend
ANTHROPIC_MODEL=claude-sonnet-5-5
EXTRACTION_TIMEOUT_SECONDS=180
# Full path to the claude binary if it is not on PATH
# CLAUDE_CLI_PATH=

# Claude API key: fallback backend, pay per token (optional)
# ANTHROPIC_API_KEY=

# Factuurmailbox: haal facturen op uit een eigen mailadres (IMAP, alleen via TLS).
# Gebruik een apart mailadres en stuur je facturen daar naartoe door.
# Heeft je provider app-wachtwoorden (Gmail, Microsoft, iCloud)? Maak er dan een aan.
# Het programma leest alleen mail uit IMAP_FOLDER en verplaatst afgehandelde mail naar
# IMAP_PROCESSED_FOLDER; er wordt niets verwijderd.
# IMAP_HOST=imap.example.com
# Poort 993 (versleuteld) is bijna altijd goed
# IMAP_PORT=993
# IMAP_USER=facturen@example.com
# IMAP_PASSWORD=
# Map waaruit gelezen wordt
# IMAP_FOLDER=INBOX
# Map waar verwerkte mail naartoe gaat (wordt aangemaakt als hij ontbreekt)
# IMAP_PROCESSED_FOLDER=Verwerkt
# Automatisch ophalen elke N minuten (1-1440), 0 = uit (gebruik dan de knop Nu ophalen).
# Werkt alleen zolang het programma draait.
# IMAP_POLL_INTERVAL_MINUTES=0
# Maximaal aantal mails per keer; de rest volgt de volgende keer
# IMAP_MAX_MESSAGES_PER_RUN=50
# Seconden voordat een trage mailserver wordt opgegeven
# IMAP_TIMEOUT_SECONDS=30
