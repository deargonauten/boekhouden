# Copy to .env and adjust. Environment variables override this file.

# SQLite database file (relative paths resolve against the repo root)
DATABASE_PATH=data/boekhouden.db

# Content-addressed document storage (never delete files here)
DOCUMENTS_DIR=data/documents

# Web server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# Invoice extraction (reading PDFs/photos with Claude).
# auto: use the `claude` CLI when you are logged in (counts against your plan;
# run `claude auth login` once), otherwise the API key below.
# Or force one: claude_cli | anthropic_api
EXTRACTION_BACKEND=auto
# Model alias for the CLI backend
EXTRACTION_MODEL=sonnet
# Model id for the API backend
ANTHROPIC_MODEL=claude-sonnet-5-5
EXTRACTION_TIMEOUT_SECONDS=180
# Full path to the claude binary if it is not on PATH
# CLAUDE_CLI_PATH=

# Claude API key: fallback backend, pay per token (optional)
# ANTHROPIC_API_KEY=
